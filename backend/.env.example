# Copy to .env and fill in your values
# NEVER commit .env to git

NODE_ENV=
PORT=

# MongoDB — use Atlas free tier for dev
MONGODB_URI=

# Cloudinary — from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend URL for CORS
FRONTEND_URL=

# Signed URL TTL in seconds (how long a download URL stays valid)
SIGNED_URL_TTL_SECONDS=60

# bcrypt cost factor (10 for dev speed, 12 for production)
BCRYPT_ROUNDS=10

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Storage provider ('cloudinary' for dev, 's3' for production)
STORAGE_PROVIDER=cloudinary

# Cloudinary upload folder
CLOUDINARY_UPLOAD_FOLDER=vaultshare

# REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=vaultshare:

# Security tuning
MAX_GLOBAL_ATTEMPTS_PER_FILE=20
MAX_ATTEMPTS_PER_IP=5
LOCKOUT_MS=900000

ADMIN_API_KEY=your_generated_hex_key_here

# AWS S3 (for production — leave blank to use Cloudinary)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=vaultshare-files
# AWS_CLOUDFRONT_DOMAIN=d1abc123.cloudfront.net
# AWS_UPLOAD_URL_TTL=3600